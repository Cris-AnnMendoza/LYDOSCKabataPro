  <div style="display:flex;flex-direction:column;gap:16px">
    <div class="card">
      <div class="card-header"><i class="fas fa-info-circle"></i><h3>Request Details</h3></div>
      <div style="padding:4px 0">
        <div class="info-row" style="padding:8px 18px"><span class="info-label">Organization</span><span class="info-val"><?=htmlspecialchars($viewReq['org_name'])?></span></div>
        <div class="info-row" style="padding:8px 18px"><span class="info-label">Representative</span><span class="info-val"><?=htmlspecialchars($viewReq['representative_name']?:'')?></span></div>
        <div class="info-row" style="padding:8px 18px"><span class="info-label">Activity Type</span><span class="info-val"><?=htmlspecialchars($viewReq['activity_type']?:'')?></span></div>
        <div class="info-row" style="padding:8px 18px"><span class="info-label">Target Date</span><span class="info-val"><?=$viewReq['target_date']?date('F j, Y',strtotime($viewReq['target_date'])):''?></span></div>
        <div class="info-row" style="padding:8px 18px"><span class="info-label">Venue</span><span class="info-val"><?=htmlspecialchars($viewReq['target_venue']?:'')?></span></div>
