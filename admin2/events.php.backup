            <strong><?= htmlspecialchars($ev['title']) ?></strong>
            <?php if ($ev['description']): ?>
              <br><small style="color:#94a3b8"><?= htmlspecialchars(substr($ev['description'],0,50)) ?>...</small>
            <?php endif; ?>
          </td>
          <td><span class="badge blue"><?= htmlspecialchars($eventTypeLabels[$ev['event_type']] ?? $ev['event_type']) ?></span></td>
          <td><?= date('M j, Y', strtotime($ev['event_date'])) ?><?= $ev['event_time'] ? '<br><small style="color:#94a3b8">'.date('g:i A',strtotime($ev['event_time'])).'</small>' : '' ?></td>
          <td><?= htmlspecialchars($ev['location'] ?: '—') ?></td>
          <td><strong style="color:#2e7d32">+<?= $ev['merit_points'] ?></strong></td>
          <td>
            <?php if ($ev['qr_token'] && $ev['checkin_open']): ?>
              <?php $rotCode = getRotatingCode($ev['qr_token'], $ev['id']); ?>
              <span style="font-family:monospace;font-size:1.1rem;font-weight:800;letter-spacing:.1em;background:#e8f5e9;color:#1b5e20;padding:4px 10px;border-radius:7px">
                <?= htmlspecialchars($rotCode) ?>
              </span>
              <div style="font-size:.68rem;color:#94a3b8;margin-top:3px">
                <i class="fas fa-clock"></i> <span class="countdown" id="cd-<?= $ev['id'] ?>"></span>
              </div>
            <?php elseif ($ev['qr_token'] && !$ev['checkin_open']): ?>
              <span style="color:#94a3b8;font-size:.8rem"><i class="fas fa-lock"></i> Closed</span>
            <?php else: ?>
              <span style="color:#94a3b8;font-size:.8rem">—</span>
            <?php endif; ?>
          </td>
          <!-- Check-out code — only shown after event_end_time -->
          <td>
            <?php
            $now = date('H:i:s');
            $endTime = $ev['event_end_time'] ?? null;
            if ($endTime && strlen($endTime) === 5) $endTime .= ':00';
            $checkoutAvailable = $ev['checkin_open'] && (
                ($endTime && $now >= $endTime) ||
                !empty($ev['checkout_open'])
            );
            ?>
            <?php if ($ev['qr_token'] && $checkoutAvailable): ?>
              <?php $coCode = getCheckoutCode($ev['qr_token'], $ev['id']); ?>
              <span style="font-family:monospace;font-size:1.1rem;font-weight:800;letter-spacing:.1em;background:#ffebee;color:#b71c1c;padding:4px 10px;border-radius:7px">
                <?= htmlspecialchars($coCode) ?>
              </span>
              <div style="font-size:.68rem;color:#94a3b8;margin-top:3px">
                <i class="fas fa-clock"></i> <span class="countdown" id="co-<?= $ev['id'] ?>"></span>
              </div>
            <?php elseif ($endTime && $now < $endTime): ?>
              <span style="color:#94a3b8;font-size:.78rem">
                <i class="fas fa-hourglass-half"></i> After <?= date('g:i A', strtotime($endTime)) ?>
              </span>
            <?php else: ?>
              <span style="color:#94a3b8;font-size:.8rem">—</span>
            <?php endif; ?>
          </td>
          <td>
            <strong><?= (int)($ev['checkin_count'] ?? 0) ?></strong>
            <span style="font-size:.75rem;color:#94a3b8"> attendees</span>
          </td>
          <td>
            <?php if ($ev['checkin_open']): ?>
              <span class="badge green">Open</span>
            <?php else: ?>
              <span class="badge gray">Closed</span>
            <?php endif; ?>
          </td>
          <td style="white-space:nowrap">
            <!-- View Photos -->
            <a href="event_checkins.php?id=<?= $ev['id'] ?>" class="btn-icon" style="background:#f3e5f5;color:#7b1fa2" title="Review Check-in Photos"><i class="fas fa-camera"></i></a>
            <!-- Show QR -->
            <a href="event_qr.php?id=<?= $ev['id'] ?>" class="btn-icon teal" title="Show QR / Check-in Code"><i class="fas fa-qrcode"></i></a>
            <!-- Toggle check-in -->
            <form method="POST" style="display:inline">
              <input type="hidden" name="action" value="toggle_checkin"/>
              <input type="hidden" name="event_id" value="<?= $ev['id'] ?>"/>
              <button type="submit" class="btn-icon <?= $ev['checkin_open'] ? 'orange' : 'green' ?>" title="<?= $ev['checkin_open'] ? 'Close Check-in' : 'Open Check-in' ?>">
                <i class="fas fa-<?= $ev['checkin_open'] ? 'lock-open' : 'lock' ?>"></i>
              </button>
            </form>
            <!-- Toggle check-out -->
            <form method="POST" style="display:inline">
              <input type="hidden" name="action" value="toggle_checkout"/>
              <input type="hidden" name="event_id" value="<?= $ev['id'] ?>"/>
              <button type="submit" class="btn-icon <?= $checkoutAvailable ? 'red' : '' ?>" style="<?= !$checkoutAvailable ? 'color:#f57f17;background:#fff8e1' : '' ?>" title="<?= $checkoutAvailable ? 'Close Check-out' : 'Open Check-out Now' ?>">
                <i class="fas fa-sign-out-alt"></i>
              </button>
            </form>
            <!-- Edit -->
            <button class="btn-icon edit" title="Edit Event"
              onclick="openEditEvent(<?= htmlspecialchars(json_encode($ev), ENT_QUOTES) ?>)">
              <i class="fas fa-edit"></i>
            </button>
            <!-- Delete -->
            <form method="POST" style="display:inline" onsubmit="return confirm('Delete this event? All check-ins and certificates will also be deleted.')">
              <input type="hidden" name="action" value="delete_event"/>
